FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 换阿里云源并安装必要工具（一次装齐，包括 gcc）
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g; s/security.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends socat patchelf gcc && \
    rm -rf /var/lib/apt/lists/*

# 创建低权限用户
RUN groupadd -r ctf && useradd -r -g ctf -d /home/ctf -s /usr/sbin/nologin ctf

WORKDIR /home/ctf

# 复制源码、libc、ld、静态 flag
COPY pwn .
COPY libc.so.6 .
COPY ld-linux-x86-64.so.2 .
COPY flag /flag


# 用 patchelf 绑定指定的 libc 和动态链接器（注意这里是 pwn）
RUN patchelf --set-interpreter /home/ctf/ld-linux-x86-64.so.2 /home/ctf/pwn && \
    patchelf --set-rpath /home/ctf /home/ctf/pwn

# 权限设置（统一用 pwn）
RUN chmod 755 /home/ctf/pwn && \
    chmod 644 /home/ctf/libc.so.6 && \
    chmod 755 /home/ctf/ld-linux-x86-64.so.2 && \
    chmod 444 /flag && \
    chown -R root:ctf /home/ctf

EXPOSE 10001

# ENTRYPOINT 也用 pwn
ENTRYPOINT ["socat", "TCP-LISTEN:10001,reuseaddr,fork", "EXEC:/home/ctf/pwn,stderr"]